---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsCard from '../components/NewsCard.astro';
import Icon from '../components/Icon.astro';
import { getNewsPage } from '../lib/novice';
import { path, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: number;
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const { items, pages } = await getNewsPage(page);
const pageHref = (n: number) => (n === 1 ? path(lang, 'news') : path(lang, 'news', `${lang === 'sl' ? 'stran' : 'page'}/${n}`));
const title = page > 1 ? `${t('nav.news')} – ${t('news.page')} ${page}` : t('nav.news');
---

<BaseLayout lang={lang} title={title} description={t('news.lead')}>
  <PageHeader lang={lang} title={t('nav.news')} lead={t('news.lead')} />
  <div class="container section">
    {
      items.length ? (
        <div class="news-grid">
          {items.map((entry) => (
            <NewsCard entry={entry} lang={lang} />
          ))}
        </div>
      ) : (
        <p>{t('news.empty')}</p>
      )
    }

    {
      pages > 1 && (
        <nav class="pagination" aria-label={t('news.pagination')}>
          {page > 1 ? (
            <a class="btn btn--ghost" href={pageHref(page - 1)} rel="prev">
              <Icon name="arrow-left" size={18} /> {t('news.prev')}
            </a>
          ) : (
            <span />
          )}
          <ol>
            {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (
              <li>
                <a href={pageHref(n)} aria-current={n === page ? 'page' : undefined}>
                  <span class="visually-hidden">{t('news.page')} </span>
                  {n}
                </a>
              </li>
            ))}
          </ol>
          {page < pages ? (
            <a class="btn btn--ghost" href={pageHref(page + 1)} rel="next">
              {t('news.next')} <Icon name="arrow" size={18} />
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <p class="note" style="margin-top:3rem">
      {t('news.older')} <a href={path(lang, 'archive')}>{t('nav.archive')} →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
  }
  .pagination ol {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pagination ol a {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .pagination ol a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
