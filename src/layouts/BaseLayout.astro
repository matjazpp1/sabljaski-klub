---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { stockImage } from '../lib/stock';
import { alternatePath, languages, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** Poti iste strani v drugih jezikih, če jih ni mogoče izračunati samodejno. */
  alternates?: Partial<Record<Lang, string>>;
  type?: 'website' | 'article';
}
const { lang, title, description, image, alternates = {}, type = 'website' } = Astro.props;
const t = useTranslations(lang);
const kontakt = (await getEntry('kontakt', 'kontakt'))!.data;

const siteName = t('site.name');
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} – ${lang === 'sl' ? 'sabljanje v Ljubljani' : 'fencing in Ljubljana'}`;
const metaDescription = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const hrefs = Object.fromEntries(
  languages.map((l) => [l, new URL(alternates[l] ?? (l === lang ? Astro.url.pathname : alternatePath(Astro.url.pathname, l)), Astro.site).href]),
) as Record<Lang, string>;

const og = await getImage({ src: image ?? stockImage('og.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: kontakt.klub,
  alternateName: 'SK Ljubljana',
  sport: 'Fencing',
  url: new URL('/', Astro.site).href,
  logo: new URL('/icon.png', Astro.site).href,
  image: ogUrl,
  email: kontakt.email,
  telephone: `+386 ${kontakt.telefon.replace(/^0/, '')}`,
  taxID: kontakt.davcna,
  address: {
    '@type': 'PostalAddress',
    streetAddress: kontakt.naslov,
    postalCode: kontakt.posta.split(' ')[0],
    addressLocality: kontakt.posta.split(' ').slice(1).join(' '),
    addressCountry: 'SI',
  },
  geo: { '@type': 'GeoCoordinates', latitude: kontakt.lat, longitude: kontakt.lon },
  sameAs: [kontakt.facebook, kontakt.instagram],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={hrefs[l]} />)}
    <link rel="alternate" hreflang="x-default" href={hrefs.sl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f1211" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'sl' ? 'sl_SI' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // nežna animacija elementov ob pomikanju (.reveal)
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && items.length) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -10% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
