---
import { Image } from 'astro:assets';
import { formatDate, path, useTranslations, type Lang } from '../i18n';
import { localize, slugOf, type Novica } from '../lib/novice';

interface Props {
  entry: Novica;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { title, excerpt } = localize(entry, lang);
const { cover, cover_alt, date } = entry.data;
const href = path(lang, 'news', slugOf(entry));
---

<article class="news-card">
  <div class="news-card__media">
    {
      cover ? (
        <Image src={cover} alt={cover_alt ?? ''} widths={[400, 640, 800]} sizes="(max-width: 700px) 100vw, 400px" />
      ) : (
        <div class="news-card__placeholder" aria-hidden="true">
          <img src="/icon.png" alt="" width="120" height="120" loading="lazy" />
        </div>
      )
    }
  </div>
  <div class="news-card__body">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
    <h3><a href={href}>{title}</a></h3>
    {excerpt && <p>{excerpt}</p>}
    <span class="news-card__more" aria-hidden="true">{t('readMore')} →</span>
  </div>
</article>

<style>
  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border-bottom: 3px solid transparent;
    transition:
      border-color 0.25s,
      transform 0.25s var(--ease);
  }
  .news-card:hover,
  .news-card:focus-within {
    border-color: var(--accent-light);
    transform: translateY(-4px);
  }
  .news-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--accent-dark);
  }
  .news-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .news-card:hover .news-card__media img {
    transform: scale(1.04);
  }
  .news-card__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0 2px, transparent 2px 14px),
      var(--accent-dark);
  }
  .news-card__placeholder img {
    width: 34%;
    height: auto;
    opacity: 0.9;
  }
  .news-card:hover .news-card__placeholder img {
    transform: none;
  }
  .news-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem 1.5rem 1.75rem;
  }
  time {
    color: var(--accent-light);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h3 {
    margin: 0.5rem 0 0.75rem;
    font-size: 1.3rem;
    line-height: 1.2;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* celotna kartica je klikljiva */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  p {
    color: var(--muted);
    font-size: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card__more {
    margin-top: auto;
    color: var(--accent-light);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
