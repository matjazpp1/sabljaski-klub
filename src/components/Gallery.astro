---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  images: { image: ImageMetadata; alt?: string; alt_en?: string }[];
  /** Osnova za samodejni opis slike, npr. naslov galerije. */
  title: string;
}
const { lang, images, title } = Astro.props;
const t = useTranslations(lang);

const items = await Promise.all(
  images.map(async (img, i) => {
    const full = await getImage({ src: img.image, width: Math.min(img.image.width, 1800), format: 'webp' });
    const alt =
      (lang === 'en' ? img.alt_en || img.alt : img.alt) || `${title} – ${t('gallery.photo')} ${i + 1}`;
    return { ...img, alt, full };
  }),
);
---

<ul class="gallery" data-gallery aria-label={`${t('gallery.label')}: ${title}`}>
  {
    items.map((it) => (
      <li>
        <a
          href={it.full.src}
          data-pswp-width={it.full.attributes.width ?? it.image.width}
          data-pswp-height={it.full.attributes.height ?? it.image.height}
        >
          <Image src={it.image} alt={it.alt} widths={[240, 360, 480]} sizes="(max-width: 600px) 50vw, 240px" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery a {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
  }
  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.4s var(--ease),
      opacity 0.2s;
  }
  .gallery a:hover img,
  .gallery a:focus-visible img {
    transform: scale(1.05);
    opacity: 0.9;
  }
  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.95,
    });
    // opis slike (alt) kot dostopno ime v pregledovalniku
    lightbox.addFilter('itemData', (data) => {
      const img = (data.element as HTMLElement | undefined)?.querySelector('img');
      return { ...data, alt: img?.alt };
    });
    lightbox.init();
  });
</script>
