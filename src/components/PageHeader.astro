---
import { Image } from 'astro:assets';
import { stockImage } from '../lib/stock';
import { path, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  /** Vmesni nivoji drobtinic (brez Domov in trenutne strani). */
  crumbs?: { label: string; href?: string }[];
  /** Ime fotografije v src/assets/stock/ za ozadje. */
  image?: string;
}
const { lang, title, lead, crumbs = [], image = 'pas-1.jpg' } = Astro.props;
const t = useTranslations(lang);
---

<header class="page-header">
  <Image src={stockImage(image)} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="page-header__img" loading="eager" />
  <div class="container page-header__inner">
    <nav aria-label={t('breadcrumbs')}>
      <ol class="crumbs">
        <li><a href={path(lang, 'home')}>{t('nav.home')}</a></li>
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>)}
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>

<style>
  .page-header {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
    border-bottom: 3px solid var(--accent);
  }
  .page-header__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(10, 14, 12, 0.95) 0%, rgba(10, 14, 12, 0.82) 60%, rgba(30, 69, 53, 0.7) 100%);
  }
  .page-header__inner {
    position: relative;
    z-index: 2;
  }
  h1 {
    margin: 0;
    color: var(--accent-light);
    font-size: clamp(2.2rem, 5vw, 3.75rem);
  }
  .lead {
    margin: 1rem 0 0;
    color: var(--text);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--line);
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  [aria-current='page'] {
    color: var(--text);
  }
</style>
